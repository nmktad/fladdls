FED_CONFIG_K=2      # Number of clients
FED_CONFIG_R=20     # Number of rounds
FED_CONFIG_E=3      # Number of epochs
FED_CONFIG_B=64     # Mini batch size
FED_CONFIG_M="sync" # Mode of operation


